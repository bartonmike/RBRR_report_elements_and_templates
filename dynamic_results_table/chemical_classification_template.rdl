  <Code>Public Function largest_string(ByVal SampleName As String) As Integer
	Dim StringArray() As String = Split(SampleName, " ")
	Dim Greatestlength as Integer = 0
	
	For i As Integer = 0 To StringArray.Length - 1
    If Len(StringArray(i)) &gt; Greatestlength Then
        Greatestlength = Len(StringArray(i))
    End If 
	Next
	
	Return GreatestLength
End Function</Code>
